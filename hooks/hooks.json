{
  "description": "HackForge guardrails: state injection, deadline nudges, git/secret guard, judge-file + freeze guard. All no-op outside a project with .hackforge/state.json. Profile via env HACKFORGE_HOOKS=off|fast|safe or the plugin option hook_profile.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-context.mjs"], "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/clock-nudge.mjs"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/git-guard.mjs"], "timeout": 90 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard-edits.mjs"], "timeout": 10 }
        ]
      }
    ]
  }
}
